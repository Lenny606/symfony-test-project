{% extends 'admin/partials/administration_layout.html.twig' %}

{% block body %}
    <style>
        :root {
            --btn-bg: #1E1F25;
            --btn-color: #cbcbcb;
            --btn-color-hover: #fff;
            --grad-color1: #eeaf61;
            --grad-color2: #fb9062;
            --grad-color3: #ee5d6c;
            --grad-color4: #ce4949;
            --grad-color5: #6a0d83;
        }
        .border-grad {
            background: linear-gradient(115deg,
            var(--grad-color1),
            var(--grad-color2),
            var(--grad-color3),
            var(--grad-color4),
            var(--grad-color5)
            );
            padding: 4px;
        }

        .border-grad:hover {
            background: linear-gradient(230deg,
            var(--grad-color1),
            var(--grad-color2),
            var(--grad-color3),
            var(--grad-color4),
            var(--grad-color5)
            );
        }
        .border-grad:hover .btn-grad {
            color: var(--btn-color-hover);
            padding: 1.1em 1.6em;
        }
        .btn-grad {
            border: none;
            background: var(--btn-bg);
            color: var(--btn-color);
            font-family: inherit;
            padding: 0.5em .5em;
            letter-spacing: 0.1em;
        }
        .btn-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 50vh;
        }
    </style>
    {% for message in app.flashes('success') %}
        <div class="rounded-md pd-2 bg-green-300 border dark:border-green-600">{{ message }}</div>
    {% endfor %}
    <h2 class="text-3xl font-semibold mb-4">CSS Styles</h2>

    <div class="btn-container">
        <div class="border-grad">
            <button class="btn-grad">Button</button>
        </div>
    </div>


{% endblock %}